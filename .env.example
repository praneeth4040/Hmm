# Application Configuration
PORT=3000
NODE_ENV=development

# Database Connection (Neon DB / PostgreSQL)
# Replace with your actual Neon database connection string
DATABASE_URL="postgresql://user:password@ep-slug-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Auth Secret (Used for signing user session tokens)
JWT_SECRET="your-super-secret-jwt-key"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"

# Hugging Face Storage Bucket (S3 Gateway API)
HF_NAMESPACE="your-hugging-face-namespace"
HF_BUCKET_NAME="your-hugging-face-bucket-name"
HF_S3_ACCESS_KEY_ID="your-hf-s3-access-key-id"
HF_S3_SECRET_ACCESS_KEY="your-hf-s3-secret-access-key"

# OpenRouter LLM API
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_DEFAULT_MODEL="deepseek/deepseek-v4-pro"

# Test Configuration
API_BASE_URL="http://localhost:3000/api/v1"
TEST_JWT_TOKEN="your-jwt-token-for-testing"
