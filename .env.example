# Application Configuration
PORT=3000
NODE_ENV=development

# Database Connection (Neon DB / PostgreSQL)
# Replace with your actual Neon database connection string
DATABASE_URL="postgresql://user:password@ep-slug-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Auth Secret (Used for signing user session tokens)
JWT_SECRET="your-super-secret-jwt-key"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
