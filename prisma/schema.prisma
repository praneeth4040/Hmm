datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt      @map("updated_at")
  accounts  Account[]
  videos    Video[]

  @@map("users")
}

model Account {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  provider          String
  providerAccountId String    @map("provider_account_id")
  email             String
  accessToken       String?   @map("access_token")
  refreshToken      String?   @map("refresh_token")
  expiresAt         DateTime? @map("expires_at")
  scope             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// ── Video processing pipeline ────────────────────────────────────────────────

enum VideoStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model Video {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")

  // Reddit source metadata
  redditUrl    String      @map("reddit_url")
  redditPostId String      @map("reddit_post_id")
  redditTitle  String?     @map("reddit_title")
  redditAuthor String?     @map("reddit_author")
  subreddit    String?

  // Hugging Face Bucket storage
  // Canonical URI: hf://buckets/<namespace>/<bucket>/<key>
  hfBucketUri  String?     @map("hf_bucket_uri")

  // Video metadata (populated after download)
  fileSizeBytes BigInt?    @map("file_size_bytes")

  // Processing lifecycle
  status       VideoStatus @default(PENDING)
  errorMessage String?     @map("error_message")

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("videos")
}
